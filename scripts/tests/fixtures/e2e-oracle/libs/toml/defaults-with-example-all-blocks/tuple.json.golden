{
  "files": {
    "defaults.toml": {
      "content": "# tests/e2e/defaults.toml â committed defaults for the e2e runner.\n#\n# Schema overview (see docs/adr/0003-e2e-runner-toml.md for the full contract):\n#\n#   [cli.<name>]\n#     image         = \"<docker-image-tag>\"      # required\n#     command       = [\"<argv0>\", \"<arg1>\"]     # required\n#     command_args  = [\"<extra>\", ...]          # optional, default []\n#     mounts        = [\"host:container[:mode]\"] # required, may be []\n#     env_keys      = [\"VAR_NAME\", ...]         # required, may be []\n#     byok_provider = \"<name>\"                  # optional, cli.copilot only â the\n#                                                #   bring-your-own-key provider\n#                                                #   probe A (05-copilot-model-\n#                                                #   routing, spec 0194) is\n#                                                #   exercised against. Unset here;\n#                                                #   the default machine skips\n#                                                #   probe A. Declarative only â\n#                                                #   the scenario additionally\n#                                                #   requires .command to differ\n#                                                #   from a defaults-only merge\n#                                                #   before it trusts the label.\n#     byok_model    = \"<name>\"                  # optional, cli.copilot only â the\n#                                                #   model exercised through that\n#                                                #   provider. Same backing rule.\n#\n#   [scenarios.<name>]                          # populated by issue #80\n#     description  = \"...\"\n#     command_args = [...]\n#     applies_to   = [\"claude\", \"gemini\", \"copilot\"]\n#\n# Path interpolation:\n#   The literal token \"${CREWRIG_E2E_HOME}\" in mount strings is replaced by\n#   the runner at execution time with the host's e2e home dir\n#   (typically \"$HOME/.crewrig-e2e\", overridable via $CREWRIG_E2E_HOME).\n#   This keeps the committed defaults portable across machines.\n#\n# Local overrides:\n#   Copy tests/e2e/local.toml.example to tests/e2e/local.toml (gitignored)\n#   to override any field. Arrays APPEND, scalars REPLACE, new tables graft\n#   in. See ADR 0003 Decision 2 for the full merge semantics.\n\n[cli.claude]\nimage        = \"crewrig/e2e-claude:latest\"\ncommand      = [\"claude\"]\ncommand_args = []\nmounts       = [\n  \"${CREWRIG_E2E_HOME}/claude:/home/agent/.claude:ro\",\n  \"${CREWRIG_E2E_HOME}/claude/.claude.json:/home/agent/.claude.json:ro\"\n]\nenv_keys     = [\"ANTHROPIC_API_KEY\"]\n\n[cli.gemini]\nimage        = \"crewrig/e2e-gemini:latest\"\n# Container-side bootstrap (issue #148 Decision 5 Revision 3): copy the\n# auth bundle + layered-context rules into a writable home owned by\n# `agent`, then patch settings.json.context.fileName with the dynamic\n# basename manifest so `gemini -p` autoloads the 00â60 rules. The\n# sandboxed login's settings.json carries only the `security` block;\n# without this manifest patch, rules sit inert in the container and\n# the CLI hallucinates instead of reading PROFILE.md (tester evidence\n# at commit 6260e5e). jq is shipped in crewrig/e2e-base (/usr/bin/jq).\n#\n# `set -e` makes mkdir/cp fatal. `cp -a` preserves modes so\n# oauth_creds.json stays 0600 (Med-3 from the #148 security review).\n# The `[ -n \"$M\" ]` guard means a soft-skipped rules copy also skips\n# the manifest patch â no stale context.fileName pointing at absent\n# files. `> tmp && mv` is atomic: a jq error mid-pipeline leaves the\n# bundle's settings.json untouched. Per Rev 3, chown collapses back to\n# `|| true` (the bounded-ugliness threshold favours readability now\n# the chain is longer).\ncommand      = [\n  \"bash\", \"-c\",\n  \"set -e; D=/home/agent/.gemini; mkdir -p $D && cp -a /run/gemini-creds/. $D/ && { cp -a /run/gemini-rules/[0-6]0_*.md $D/ 2>/dev/null || echo '[bootstrap] no layered-context rules found at /run/gemini-rules/ â gemini/01 will likely fail' >&2; } && M=$(ls $D/[0-6]0_*.md 2>/dev/null | xargs -r -n1 basename | jq -R . | jq -s .) && [ \\\"$M\\\" != \\\"[]\\\" ] && jq --argjson m \\\"$M\\\" '.context.fileName = $m' $D/settings.json > $D/settings.json.tmp && mv $D/settings.json.tmp $D/settings.json; chown -R agent:agent $D 2>/dev/null || true; exec gemini \\\"$@\\\"\",\n  \"sh\"\n]\ncommand_args = []\n# Two-mount layout (issue #148 Decision 5 Revision 2):\n#   /run/gemini-creds â sandboxed auth bundle (load-bearing for login).\n#   /run/gemini-rules â host's deployed layered-context rules (00â60 files).\n# DO NOT widen the bootstrap glob from `[0-6]0_*.md` to anything broader\n# (e.g. `cp -a /run/gemini-rules/. â¦`) without revisiting Decision 5\n# Revision 2 â the user's host `~/.gemini` carries personal state\n# (history/, extensions/, MCP configs) that MUST NOT leak into the\n# scenario container.\nmounts       = [\n  \"${CREWRIG_E2E_HOME}/gemini:/run/gemini-creds:ro\",\n  \"${HOME}/.gemini:/run/gemini-rules:ro\",\n]\nenv_keys     = [\"GEMINI_API_KEY\"]\n\n[cli.copilot]\n# Copilot accepts either an env-var token (ADR 0002 Decision 4 â\n# COPILOT_GITHUB_TOKEN canonical, GH_TOKEN a fallback honored by\n# e2e_auth_ready) OR the workstation's own persisted credential (spec 0194\n# R1-R3): scripts/e2e/auth-copilot.sh already copies ~/.copilot/config.json\n# into the bundle, and the mount below is what makes that copy visible to\n# scenario containers. Mode is `rw` because Copilot writes session-state/\n# into its config dir at runtime â the residual (a container can corrupt\n# or replace the copied config.json) is\n# accepted and stated in tests/e2e/README.md. The runner's\n# e2e_ensure_bundle_dir / e2e_assert_bundle_modes bracket keeps the host\n# path safe to mount and its modes correct (spec 0194 R5).\nimage        = \"crewrig/e2e-copilot:latest\"\ncommand      = [\"copilot\"]\ncommand_args = []\nmounts       = [\n  \"${CREWRIG_E2E_HOME}/copilot:/home/agent/.copilot:rw\"\n]\nenv_keys     = [\"COPILOT_GITHUB_TOKEN\"]\n\n# [judge] â LLM-as-judge wrapper config (see ADR 0004 Decision 4 and\n# tests/e2e/lib/llm_judge.sh). All fields are overridable via local.toml.\n# `api_key_env` is intentionally distinct from `ANTHROPIC_API_KEY` so the\n# judge's billing/quota line stays separated from the runtime CLI key\n# (which may point at the same upstream key value â separation is about\n# accounting, not secrecy).\n[judge]\nbackend     = \"anthropic\"                    # Selects tests/e2e/lib/llm_judge_drivers/<backend>.sh.\nmodel       = \"claude-sonnet-4-6\"            # Update when a newer stable Sonnet ships.\napi_key_env = \"ANTHROPIC_JUDGE_API_KEY\"\nauth_mode   = \"api_key\"                      # \"api_key\" (default) | \"oauth\" â see ADR 0008. Only honored by drivers that branch on it (e.g. claude-code).\n# gcp_project = \"\"                       # Optional Google Cloud project; forwarded as x-goog-user-project when set.\nendpoint    = \"https://api.anthropic.com/v1/messages\"\nmax_tokens  = 256\nstrict      = false                          # UNCERTAIN warns; does NOT fail.\ntemperature = 0.0                            # Forwarded to the backend driver. Deterministic by default.\nmax_calls   = 30                             # Per-run hard cap on Messages API calls.\n\n# [scenarios.*] â the four pillar scenarios (issue #80, ADR 0005).\n#\n# Each scenario owns a host-side orchestrator at\n# tests/e2e/scenarios/<name>/run.sh. The runner exports the env-var\n# contract (E2E_LIB_DIR, E2E_REPORT_DIR, E2E_CLI, E2E_IMAGE,\n# E2E_EFFECTIVE_JSON, E2E_CREWRIG_E2E_HOME, E2E_SCENARIO_DIR,\n# E2E_RUN_ID) and delegates. `command_args` is intentionally omitted â\n# scenarios assemble their own docker argv.\n\n[scenarios.01-layered-context]\ndescription = \"00-60 rule files steer the CLI's profile-aware answer (location probe).\"\napplies_to  = [\"claude\", \"gemini\", \"copilot\"]\n\n[scenarios.02-cross-tool-memory]\ndescription = \"A drawer written by CLI A is read by CLI B via a shared MemPalace sidecar.\"\napplies_to  = [\"claude\", \"gemini\"]\n\n[scenarios.03-skill-build]\ndescription = \"scripts/build-components.ts emits CLI-specific artefacts inside the container.\"\napplies_to  = [\"claude\", \"gemini\", \"copilot\"]\n\n[scenarios.04-harness-loop]\ndescription = \"harness-report â MemPalace â harness-curator round-trip.\"\napplies_to  = [\"claude\", \"gemini\", \"copilot\"]\n\n# [scenarios.05-copilot-model-routing] â probe A (spec 0194 R8-R11). Adjudicates\n# github/copilot-cli#4437: a `model:` hint in a repository agent declaration on\n# a bring-your-own-key session either fires the upstream bug or it does not.\n# Declarative-only precondition (byok_provider/byok_model above); the scenario\n# itself verifies the declaration is backed before trusting it. Not gated by\n# requirements 1-7 â runs on whichever Copilot credential path is already\n# ready (spec 0194 R10).\n[scenarios.05-copilot-model-routing]\ndescription = \"Differential probe for github/copilot-cli#4437 â does a model: hint in a repo agent declaration break BYOK subagent routing?\"\napplies_to  = [\"copilot\"]\n\n# [scenarios.06-agent-surface-consumption] â probe B (spec 0194 R12-R15).\n# Determines, per CLI and per per-file layout, whether that CLI's agent\n# reader consumes a repository .claude/agents/ declaration. Grounds epic\n# #1100's compiled-layout seam. R12 \"at least\" â covers copilot and claude.\n[scenarios.06-agent-surface-consumption]\ndescription = \"Per-CLI, per-layout determination of whether .claude/agents/ declarations are consumed (nested vs flat).\"\napplies_to  = [\"copilot\", \"claude\"]\n\n# [scenarios.07-guidance-surface] â probe C (spec 0203). Evaluates guidance-surface\n# prose vs Copilot reader, effort: frontmatter key, and orchestrator guidance\n# reliability. Grounds spec 0197 assumptions.\n[scenarios.07-guidance-surface]\ndescription = \"Probe C (spec 0203) â evaluates prose vs Copilot reader, effort: frontmatter, and orchestrator guidance reliability.\"\napplies_to  = [\"copilot\", \"claude\"]\n\n",
      "mode": "0644"
    },
    "local.toml": {
      "content": "# tests/e2e/local.toml.example â sample local override (commit-friendly).\n#\n# Copy this file to tests/e2e/local.toml (which is gitignored) to override\n# the committed defaults at run time. The runner deep-merges this file over\n# tests/e2e/defaults.toml â arrays APPEND, scalars REPLACE, new tables graft\n# in. See ADR 0003 Decision 2 for the exact semantics.\n#\n# Note: `command` is treated as REPLACE (not APPEND) at merge time â the full\n# command array from local.toml wins, discarding the defaults entry. See\n# tests/e2e/lib/toml_merge.sh for the post-merge fixup logic.\n#\n# Common use case: route Copilot through Ollama Cloud for local validation\n# without spending real GitHub Copilot quota. The wrapper below:\n#   1. Copies the Ed25519 keypair from the read-only credential mount\n#      (/run/ollama-creds) into a writable ~/.ollama, tightening modes to\n#      0700 (dirs) / 0600 (files) â the copy-into-writable pattern. A\n#      direct :ro mount AT ~/.ollama (the prior shape) breaks recent\n#      ollama clients, which write their own temp state under ~/.ollama\n#      and fail with EROFS against a read-only bind mount there (issue\n#      #1107).\n#   2. Starts `ollama serve` in the background with OLLAMA_MODELS redirected\n#      to /tmp/ so its own writes never depend on ~/.ollama being writable\n#      for anything beyond the keypair copied into it above.\n#   3. Launches `ollama launch copilot --model glm-5.3-flash:cloud` with\n#      --yes (skip confirmation) and --allow-all (permit file writes in\n#      non-interactive mode).\n#\n# The harness targets the LATEST ollama client â no version pin (maintainer\n# policy; see issue #1107).\n#\n# Prerequisites:\n#   task e2e:auth:ollama   â register the Ed25519 keypair once\n#   task e2e:auth:copilot  â copy instructions + config.json into e2e dir\n\n# When this override is active, run `task e2e:auth:ollama` once to register\n# the dedicated test account's Ed25519 keypair under\n# ${CREWRIG_E2E_HOME}/ollama/. The mount at /run/ollama-creds keeps the\n# source read-only; the in-container setup step below copies it into a\n# writable ~/.ollama before ollama serve/launch run â see point 1 above.\n[cli.copilot]\ncommand       = [\"bash\", \"-c\", \"mkdir -p ~/.ollama && cp -r /run/ollama-creds/. ~/.ollama/ && find ~/.ollama -type f -exec chmod 600 {} + && find ~/.ollama -type d -exec chmod 700 {} + && (OLLAMA_MODELS=/tmp/ollama-models ollama serve >/dev/null 2>&1 &) && sleep 3 && exec ollama launch copilot --model glm-5.3-flash:cloud --yes -- --allow-all \\\"$@\\\"\", \"sh\"]\nmounts        = [\"${CREWRIG_E2E_HOME}/ollama:/run/ollama-creds:ro\"]\nenv_keys      = [\"COPILOT_GITHUB_TOKEN\", \"OLLAMA_HOST\"]\n# Declarative label for probe A (05-copilot-model-routing, spec 0194 R8-R11) â\n# the scenario backs this against the effective `command` above before\n# trusting it (a declared-but-unbacked pair exits 78 naming the mismatch).\nbyok_provider = \"ollama-cloud\"\nbyok_model    = \"glm-5.3-flash:cloud\"\n\n# Re-use the OAuth token minted by `task e2e:auth:claude` instead of\n# `ANTHROPIC_JUDGE_API_KEY`. The claude-code driver reads the access\n# token from ${CLAUDE_CREDENTIALS_PATH:-~/.claude/.credentials.json}.\n# See ADR 0008 for the full design.\n[judge]\nbackend     = \"claude-code\"\nauth_mode   = \"oauth\"\nmodel       = \"claude-sonnet-4-6\"\ntemperature = 0.0\nstrict      = false\n\n# Use Ollama Cloud as the LLM judge â API key mode.\n# Requires OLLAMA_API_KEY to be set in the environment.\n[judge]\nbackend     = \"ollama-cloud\"\nauth_mode   = \"api_key\"\napi_key_env = \"OLLAMA_API_KEY\"\nmodel       = \"deepseek-v4-pro:cloud\"\ntemperature = 0.0\nstrict      = false\n\n# Use Ollama Cloud as the LLM judge â keypair mode.\n# Reuses the Ed25519 keypair registered by `task e2e:auth:ollama`.\n# No extra env var required when CREWRIG_E2E_HOME is set correctly.\n[judge]\nbackend     = \"ollama-cloud\"\nauth_mode   = \"keypair\"\nmodel       = \"deepseek-v4-pro:cloud\"\ntemperature = 0.0\nstrict      = false\n\n# Use Gemini as the LLM judge with an API key (GEMINI_API_KEY env var).\n[judge]\nbackend     = \"gemini\"\nauth_mode   = \"api_key\"\napi_key_env = \"GEMINI_API_KEY\"\nmodel       = \"gemini-2.5-pro\"\ntemperature = 0.0\nstrict      = false\n\n# Use Gemini as the LLM judge via OAuth (re-uses the token minted by\n# `task e2e:auth:gemini`). Reads from\n# ${GEMINI_CREDENTIALS_PATH:-~/.crewrig-e2e/gemini/oauth_creds.json}.\n# An optional gcp_project forwards x-goog-user-project to the API.\n[judge]\nbackend     = \"gemini\"\nauth_mode   = \"oauth\"\nmodel       = \"gemini-2.5-pro\"\ngcp_project = \"my-gcp-project-id\"   # optional\ntemperature = 0.0\nstrict      = false\n",
      "mode": "0644"
    }
  },
  "id": "toml/defaults-with-example-all-blocks",
  "rc": 0,
  "stats": {},
  "stderr": "",
  "stdout": "{\n  \"cli\": {\n    \"claude\": {\n      \"image\": \"crewrig/e2e-claude:latest\",\n      \"command\": [\n        \"claude\"\n      ],\n      \"command_args\": [],\n      \"mounts\": [\n        \"${CREWRIG_E2E_HOME}/claude:/home/agent/.claude:ro\",\n        \"${CREWRIG_E2E_HOME}/claude/.claude.json:/home/agent/.claude.json:ro\"\n      ],\n      \"env_keys\": [\n        \"ANTHROPIC_API_KEY\"\n      ]\n    },\n    \"gemini\": {\n      \"image\": \"crewrig/e2e-gemini:latest\",\n      \"command\": [\n        \"bash\",\n        \"-c\",\n        \"set -e; D=/home/agent/.gemini; mkdir -p $D && cp -a /run/gemini-creds/. $D/ && { cp -a /run/gemini-rules/[0-6]0_*.md $D/ 2>/dev/null || echo '[bootstrap] no layered-context rules found at /run/gemini-rules/ â gemini/01 will likely fail' >&2; } && M=$(ls $D/[0-6]0_*.md 2>/dev/null | xargs -r -n1 basename | jq -R . | jq -s .) && [ \\\"$M\\\" != \\\"[]\\\" ] && jq --argjson m \\\"$M\\\" '.context.fileName = $m' $D/settings.json > $D/settings.json.tmp && mv $D/settings.json.tmp $D/settings.json; chown -R agent:agent $D 2>/dev/null || true; exec gemini \\\"$@\\\"\",\n        \"sh\"\n      ],\n      \"command_args\": [],\n      \"mounts\": [\n        \"${CREWRIG_E2E_HOME}/gemini:/run/gemini-creds:ro\",\n        \"${HOME}/.gemini:/run/gemini-rules:ro\"\n      ],\n      \"env_keys\": [\n        \"GEMINI_API_KEY\"\n      ]\n    },\n    \"copilot\": {\n      \"image\": \"crewrig/e2e-copilot:latest\",\n      \"command\": [\n        \"bash\",\n        \"-c\",\n        \"mkdir -p ~/.ollama && cp -r /run/ollama-creds/. ~/.ollama/ && find ~/.ollama -type f -exec chmod 600 {} + && find ~/.ollama -type d -exec chmod 700 {} + && (OLLAMA_MODELS=/tmp/ollama-models ollama serve >/dev/null 2>&1 &) && sleep 3 && exec ollama launch copilot --model glm-5.3-flash:cloud --yes -- --allow-all \\\"$@\\\"\",\n        \"sh\"\n      ],\n      \"command_args\": [],\n      \"mounts\": [\n        \"${CREWRIG_E2E_HOME}/copilot:/home/agent/.copilot:rw\",\n        \"${CREWRIG_E2E_HOME}/ollama:/run/ollama-creds:ro\"\n      ],\n      \"env_keys\": [\n        \"COPILOT_GITHUB_TOKEN\",\n        \"OLLAMA_HOST\"\n      ],\n      \"byok_provider\": \"ollama-cloud\",\n      \"byok_model\": \"glm-5.3-flash:cloud\"\n    }\n  },\n  \"judge\": {\n    \"backend\": \"gemini\",\n    \"model\": \"gemini-2.5-pro\",\n    \"api_key_env\": \"GEMINI_API_KEY\",\n    \"auth_mode\": \"oauth\",\n    \"endpoint\": \"https://api.anthropic.com/v1/messages\",\n    \"max_tokens\": 256,\n    \"strict\": false,\n    \"temperature\": 0,\n    \"max_calls\": 30,\n    \"gcp_project\": \"my-gcp-project-id\"\n  },\n  \"scenarios\": {\n    \"01-layered-context\": {\n      \"description\": \"00-60 rule files steer the CLI's profile-aware answer (location probe).\",\n      \"applies_to\": [\n        \"claude\",\n        \"gemini\",\n        \"copilot\"\n      ]\n    },\n    \"02-cross-tool-memory\": {\n      \"description\": \"A drawer written by CLI A is read by CLI B via a shared MemPalace sidecar.\",\n      \"applies_to\": [\n        \"claude\",\n        \"gemini\"\n      ]\n    },\n    \"03-skill-build\": {\n      \"description\": \"scripts/build-components.ts emits CLI-specific artefacts inside the container.\",\n      \"applies_to\": [\n        \"claude\",\n        \"gemini\",\n        \"copilot\"\n      ]\n    },\n    \"04-harness-loop\": {\n      \"description\": \"harness-report â MemPalace â harness-curator round-trip.\",\n      \"applies_to\": [\n        \"claude\",\n        \"gemini\",\n        \"copilot\"\n      ]\n    },\n    \"05-copilot-model-routing\": {\n      \"description\": \"Differential probe for github/copilot-cli#4437 â does a model: hint in a repo agent declaration break BYOK subagent routing?\",\n      \"applies_to\": [\n        \"copilot\"\n      ]\n    },\n    \"06-agent-surface-consumption\": {\n      \"description\": \"Per-CLI, per-layout determination of whether .claude/agents/ declarations are consumed (nested vs flat).\",\n      \"applies_to\": [\n        \"copilot\",\n        \"claude\"\n      ]\n    },\n    \"07-guidance-surface\": {\n      \"description\": \"Probe C (spec 0203) â evaluates prose vs Copilot reader, effort: frontmatter, and orchestrator guidance reliability.\",\n      \"applies_to\": [\n        \"copilot\",\n        \"claude\"\n      ]\n    }\n  }\n}\n"
}
