      "-c",
      "\nimport os, sys\n# mempalace.mcp_server swaps sys.stdout at import time to protect its\n# JSON-RPC channel; dup fd 1 BEFORE importing so we can still write\n# RESULT: to the real stdout (see ~/.claude/rules/60-tools.md → \"Stdout hazard\").\n_REAL_STDOUT = os.fdopen(os.dup(1), \"w\", encoding=\"utf-8\", closefd=False)\nos.environ[\"MEMPALACE_PALACE_DIR\"] = \"/home/agent/.mempalace/palace\"\nfrom mempalace.mcp_server import tool_add_drawer\ncontent = sys.stdin.read()\nresult = tool_add_drawer(\n    wing=\"e2e-cross-tool\",\n    room=\"task-handoff\",\n    content=content,\n    added_by=os.environ.get(\"WRITER_AGENT_ID\", \"e2e-test\"),\n)\nprint(\"RESULT:\", result, file=_REAL_STDOUT, flush=True)\nsys.exit(0 if result.get(\"success\") else 1)\n"
    ],
    [
      "run",
      "--rm",
      "-v",
      "<CONTAINER>:/home/agent/.mempalace",
      "crewrig/e2e-mempalace:latest",
      "mempalace",
      "search",
      "[TASK:ongoing]",
      "--wing",
      "e2e-cross-tool",
      "--room",
      "task-handoff",
      "--results",
      "5"
    ],
    [
      "rm",
      "-f",
      "<CONTAINER>"
    ],
    [
      "volume",
      "rm",
      "-f",
      "<CONTAINER>"
    ]
