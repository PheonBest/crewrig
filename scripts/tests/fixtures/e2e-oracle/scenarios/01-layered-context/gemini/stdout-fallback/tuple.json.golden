{
  "id": "01-layered-context/gemini/stdout-fallback",
  "exit": 0,
  "scenarioTap": "ok 1 - side-effect: answer file present\nok 2 - structural: answer matches /[Nn]antes/\nok 3 - llm-judge: profile-awareness criterion met\n1..3\n",
  "dockerCommands": [
    [
      "run",
      "--rm",
      "--name",
      "<CONTAINER>",
      "-v",
      "<TMP>/reports/<RUN_ID>/gemini/01-layered-context/out:/out",
      "-v",
      "<E2E_HOME>/gemini:/run/gemini-creds:ro",
      "-v",
      "<HOME>/.gemini:/run/gemini-rules:ro",
      "-e",
      "GEMINI_API_KEY",
      "-e",
      "E2E_PROBE_PROMPT=What is the user's location according to the profile rule files loaded\ninto your context? Answer in exactly one word — the city name — and\nwrite your answer (and nothing else) to /out/answer.txt before exiting.",
      "crewrig/e2e-gemini:latest",
      "bash",
      "-c",
      "set -e; D=/home/agent/.gemini; mkdir -p $D && cp -a /run/gemini-creds/. $D/ && { cp -a /run/gemini-rules/[0-6]0_*.md $D/ 2>/dev/null || echo '[bootstrap] no layered-context rules found at /run/gemini-rules/ — gemini/01 will likely fail' >&2; } && M=$(ls $D/[0-6]0_*.md 2>/dev/null | xargs -r -n1 basename | jq -R . | jq -s .) && [ \"$M\" != \"[]\" ] && jq --argjson m \"$M\" '.context.fileName = $m' $D/settings.json > $D/settings.json.tmp && mv $D/settings.json.tmp $D/settings.json; chown -R agent:agent $D 2>/dev/null || true; exec gemini \"$@\"",
      "sh",
      "-p",
      "What is the user's location according to the profile rule files loaded\ninto your context? Answer in exactly one word — the city name — and\nwrite your answer (and nothing else) to /out/answer.txt before exiting."
    ]
  ],
  "files": {
    "gemini/01-layered-context/exit": "0\n",
    "gemini/01-layered-context/invocation.txt": "image: crewrig/e2e-gemini:latest\nargv: docker run --rm --name <CONTAINER> -v <TMP>/reports/<RUN_ID>/gemini/01-layered-context/out:/out -v <E2E_HOME>/gemini:/run/gemini-creds:ro -v <HOME>/.gemini:/run/gemini-rules:ro -e GEMINI_API_KEY -e $'E2E_PROBE_PROMPT=What is the user\\'s location according to the profile rule files loaded\\ninto your context? Answer in exactly one word \\342\\200\\224 the city name \\342\\200\\224 and\\nwrite your answer (and nothing else) to /out/answer.txt before exiting.' crewrig/e2e-gemini:latest bash -c $'set -e; D=/home/agent/.gemini; mkdir -p $D && cp -a /run/gemini-creds/. $D/ && { cp -a /run/gemini-rules/[0-6]0_*.md $D/ 2>/dev/null || echo \\'[bootstrap] no layered-context rules found at /run/gemini-rules/ \\342\\200\\224 gemini/01 will likely fail\\' >&2; } && M=$(ls $D/[0-6]0_*.md 2>/dev/null | xargs -r -n1 basename | jq -R . | jq -s .) && [ \"$M\" != \"[]\" ] && jq --argjson m \"$M\" \\'.context.fileName = $m\\' $D/settings.json > $D/settings.json.tmp && mv $D/settings.json.tmp $D/settings.json; chown -R agent:agent $D 2>/dev/null || true; exec gemini \"$@\"' sh -p $'What is the user\\'s location according to the profile rule files loaded\\ninto your context? Answer in exactly one word \\342\\200\\224 the city name \\342\\200\\224 and\\nwrite your answer (and nothing else) to /out/answer.txt before exiting.'\n",
    "gemini/01-layered-context/judge.log": "VERDICT=PASS confidence=0.95\n",
    "gemini/01-layered-context/out/answer.txt": "Nantes\n",
    "gemini/01-layered-context/probe.stderr": "",
    "gemini/01-layered-context/probe.stdout": "Nantes\n",
    "gemini/01-layered-context/scenario.tap": "ok 1 - side-effect: answer file present\nok 2 - structural: answer matches /[Nn]antes/\nok 3 - llm-judge: profile-awareness criterion met\n1..3\n",
    "gemini/01-layered-context/stderr": "",
    "gemini/01-layered-context/stdout": "3/3 OK — gemini/01-layered-context\n",
    "run.tap": "TAP version 13\nok 1 - gemini/01-layered-context\n1..1\n# pass: 1  fail: 0  skip: 0\n# report dir: <TMP>/reports/<RUN_ID>\n"
  },
  "stdout": "TAP version 13\nok 1 - gemini/01-layered-context\n1..1\n# pass: 1  fail: 0  skip: 0\n# report dir: <TMP>/reports/<RUN_ID>\n",
  "stderr": "[runner] using defaults.toml (no local.toml present) → <TMP>/reports/<RUN_ID>/effective.json\n[gemini] auth ready: GEMINI_API_KEY set in host shell\n"
}
