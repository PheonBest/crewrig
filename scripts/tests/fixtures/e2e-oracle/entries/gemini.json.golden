  "gemini/ok-stdout": {
    "rc": 0,
    "stdout": "ok 1 - headless: gemini -p exited 0 with non-empty answer from stdout (fallback â model did not honour the side-effect ask)\n1..1\n",
    "stderr": "",
    "files": {
      "~/.crewrig-e2e/gemini/oauth_creds.json": {
        "content": "{}",
        "mode": "0644"
      },
      "~/.crewrig-e2e/gemini/settings.json": {
        "content": "{}",
        "mode": "0644"
      }
    },
    "dockerCalls": [
      [
        "image",
        "inspect",
        "crewrig/e2e-gemini:latest"
      ],
      [
        "run",
        "--rm",
        "--stop-timeout",
        "5",
        "-v",
        "<E2E_HOME>/gemini:/run/gemini-creds:ro",
        "-v",
        "<WORK>:/out",
        "--entrypoint",
        "bash",
        "crewrig/e2e-gemini:latest",
        "-c",
        "set -e; D=/home/agent/.gemini; mkdir -p $D && cp -a /run/gemini-creds/. $D/ && chown -R agent:agent $D 2>/dev/null || true; exec gemini \"$@\"",
        "sh",
        "-p",
        "Write the single word READY to /out/answer.txt and print it."
      ]
    ]
  },
