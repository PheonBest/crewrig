{
  "real: hello-world": {
    "gemini": {
      "out": "{\"default\":{\"command\":\"node\",\"args\":[\"${extensionPath}/dist/index.js\"]}}",
      "status": 0
    },
    "claude": {
      "out": "{\"default\":{\"command\":\"node\",\"args\":[\"${CLAUDE_PLUGIN_ROOT}/dist/index.js\"]}}",
      "status": 0
