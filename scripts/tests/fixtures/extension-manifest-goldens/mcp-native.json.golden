      "out": "{\"default\":{\"command\":\"node\",\"args\":[\"${COPILOT_PLUGIN_ROOT}/dist/index.js\"],\"type\":\"stdio\"}}",
      "status": 0
    },
    "antigravity": {
      "out": "{\"default\":{\"command\":\"node\",\"args\":[\"${extensionRoot}/dist/index.js\"]}}",
      "status": 0
    }
  },
